    "type.ESTP.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are made to break. Heartbeats are made to race."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則拿來打破，心跳拿來用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは破るもの。心は弾ませるもの。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 깨라고 있고, 심장은 두근거리라고 있어."
          }
        }
      }
    },
    "type.ESFP.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Captain"
