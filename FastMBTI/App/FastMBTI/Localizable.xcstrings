    "type.ESFP.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet? Never. I bring the energy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜不可能，氣氛我來扛。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かは無理。場は私が盛り上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 건 안 돼. 내가 분위기 맡을게."
          }
        }
      }
    },
    "type.ISFP.title": {
