    "type.ENFP.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not superstition. It's written in the stars."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是迷信，是劇本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷信じゃなくて、星のシナリオ。"
          }
