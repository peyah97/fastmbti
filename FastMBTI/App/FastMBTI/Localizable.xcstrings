    "type.ENTP.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not against astrology. Against the conclusion."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反對的不是星座，是結論。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反対してるのは星座じゃなくて結論。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별자리가 아니라 결론에 반대하는 거야."
          }
        }
      }
    },
    "type.ENFP.title": {
      "extractionState": "manual",
