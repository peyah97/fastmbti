        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いきり泣いた。それでも許す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한바탕 울고는 결국 용서해."
          }
        }
      }
    },
    "type.ENTP.title": {
