    "type.INFJ.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knew the answer. Just waiting to be asked."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早知道答案，只是等人問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えは知ってる。聞かれるのを待ってるだけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답은 알고 있어. 물어봐 주길 기다릴 뿐."
          }
        }
      }
    },
    "type.INFP.title": {
