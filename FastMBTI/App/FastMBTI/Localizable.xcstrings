    "type.INFP.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cried it out. Still chose to forgive."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哭完一場，還是選擇原諒。"
          }
